{
  "info": {
    "_postman_id": "af8f875e-8d4b-4c9a-9a30-23a0a9e40f12",
    "name": "Student Management REST API",
    "description": "CRUD and error-handling tests for the Student Management REST API assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "studentId", "value": "4" }
  ],
  "item": [
    { "name": "Get all students", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/students" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Response contains student list', function () { const body = pm.response.json(); pm.expect(body.success).to.eql(true); pm.expect(body.data).to.be.an('array'); });"] } }] },
    { "name": "Get student by ID", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/students/1" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }] },
    { "name": "Add student", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"course\": \"BCA\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/students" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 201', function () { pm.response.to.have.status(201); });", "const body = pm.response.json();", "pm.test('Student is created', function () { pm.expect(body.success).to.eql(true); pm.expect(body.data.name).to.eql('Aarav Sharma'); });", "pm.collectionVariables.set('studentId', body.data.id);"] } }] },
    { "name": "Get created student", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/students/{{studentId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });"] } }] },
    { "name": "Update student", "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"course\": \"BTech CSE\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/students/{{studentId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Student is updated', function () { pm.expect(pm.response.json().data.course).to.eql('BTech CSE'); });"] } }] },
    { "name": "Delete student", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/students/{{studentId}}" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 200', function () { pm.response.to.have.status(200); });", "pm.test('Student is deleted', function () { pm.expect(pm.response.json().success).to.eql(true); });"] } }] },
    { "name": "Invalid student data (400)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"course\": \"BCA\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/students" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 400', function () { pm.response.to.have.status(400); });"] } }] },
    { "name": "Student not found (404)", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/students/999999" }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Status is 404', function () { pm.response.to.have.status(404); });"] } }] }
  ]
}
